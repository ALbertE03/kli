# ── KLI Studio — build-time configuration ──────────────────────────────
# Copy to `.env.local` and fill in your keys. Anything prefixed with VITE_ is
# embedded in the bundle, so never commit real secrets here.

# FreeLLMAPI (default provider)
VITE_FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
VITE_FREELLMAPI_KEY=

# OpenAI
VITE_OPENAI_KEY=

# Anthropic
VITE_ANTHROPIC_KEY=