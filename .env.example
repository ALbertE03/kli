# --- Entorno ---
HARNESS_ENV=dev                 # en prod exige API_KEYS
LOG_LEVEL=INFO

# --- Proveedores de modelos ---
# Built-in: "openai" (API oficial) y "anthropic". Cualquier otro compatible con la
# API de OpenAI o de Anthropic (freellmapi, LM Studio, vLLM, proxies…) se registra
# por API:  POST /api/v1/providers  {"name":"freellmapi","kind":"openai",
#                                    "base_url":"http://127.0.0.1:31415/v1",
#                                    "api_key":"...","default_model":"auto"}
# y se elige en cada chat con {"provider": "freellmapi"}.
DEFAULT_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2             # modelo por defecto del built-in openai
OPENAI_API_KEY=                  # requerido para el built-in openai oficial
OPENAI_STREAM_USAGE=true         # false si tu servidor compatible no soporta stream_options
ANTHROPIC_API_KEY=               # requerido para el built-in anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
TEMPERATURE=0.2
# Modelos disponibles de un proveedor:  GET /api/v1/models?provider=<nombre>

# --- Proyectos (sandbox por carpeta) ---
PROJECTS_DIR=./projects          # proyectos nuevos: <PROJECTS_DIR>/<nombre>
# Raíces desde las que se puede importar una carpeta existente además del cwd
# (POST /api/v1/projects con "path"). Ej: ~/repos,~/Desktop
PROJECTS_IMPORT_ROOTS=
WORKSPACE_DIR=./workspace        # workspace por defecto (hilos sin proyecto)

# --- Memoria ---
CHECKPOINT_BACKEND=sqlite       # memory | sqlite | postgres
STORE_BACKEND=sqlite            # memoria a largo plazo
POSTGRES_URL=
DATA_DIR=./data

# --- Seguridad ---
API_KEYS=                       # "clave1:alice,clave2:bob". Vacío = dev, usuario por cabecera X-User-Id
SECRET_KEY=                     # clave Fernet para cifrar claves de proveedores/tools guardados (ver README)
CORS_ORIGINS=http://localhost:3000
ENABLE_EXEC=false               # habilita python_repl y terminal (peligroso fuera de un sandbox)

# --- Búsqueda y MCP ---
TAVILY_API_KEY=                 # opcional; sin clave se usa DuckDuckGo
MCP_CONFIG_FILE=./mcp_servers.json
MCP_STDIO_ALLOWLIST=npx,uvx,node,python

# --- Límites ---
RECURSION_LIMIT=100
AGENT_CACHE_SIZE=32
MAX_CUSTOM_PER_USER=50          # suma de skills + tools HTTP + MCP + proveedores por usuario

# --- Observabilidad (opcional, LangSmith) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-harness
